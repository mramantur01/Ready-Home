# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# READY HOME Server & Vercel Configuration
# Password for accessing the Admin Panel (#admin or Alt+A)
ADMIN_PASSWORD=

# Upstash Redis / Vercel KV credentials (optional: falls back to local JSON storage in dev)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Telegram Bot notifications for new renovation bookings (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
